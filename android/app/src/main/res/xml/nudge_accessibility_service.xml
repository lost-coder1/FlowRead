<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberately the most restricted accessibility configuration that still works.

  canRetrieveWindowContent="false" means this service is structurally incapable of
  reading any text on screen — it learns only that a window belonging to some package
  came to the front. packageNames is NOT declared here: it is set at runtime via
  setServiceInfo() to exactly the apps the user picked, so the service receives no
  events at all about any other app (see FlowReadNudgeService.applyTargets).

  Claude.md 1.4 (privacy by architecture) and 9.4 (Q8 sign-off, 2026-09-20).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="200"
    android:description="@string/nudge_service_description" />
