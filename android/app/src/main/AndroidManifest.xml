<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Open PDF files shared/viewed from Files, Gmail, WhatsApp, etc. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
        <!-- Reading-habit nudge (Claude.md section 9). Notices only that a
             user-chosen app came to the front; res/xml declares
             canRetrieveWindowContent="false" so it cannot read the screen. -->
        <service
            android:name=".FlowReadNudgeService"
            android:label="@string/nudge_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/nudge_accessibility_service" />
        </service>

    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- READ_EXTERNAL_STORAGE needed on Android ≤ 12 for MediaStore document queries; not needed on 13+ -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- Required for local notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Nothing schedules an exact alarm: notifications.js sets isExactNotification:false
         and relies on setAndAllowWhileIdle, which needs no special permission. The
         permission is denied by default at API 33+ anyway. @capacitor/local-notifications
         declares it in its own manifest, so tools:node="remove" is required to keep it
         out of the merged manifest — deleting our line alone would not. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:node="remove" />

    <!-- Nudge system (Claude.md section 9).
         SYSTEM_ALERT_WINDOW is what makes the nudge legal to show over another
         app: from Android 10 a background activity start is dropped without it.
         PACKAGE_USAGE_STATS is OPTIONAL — it upgrades the trigger from "3rd open
         today" to "15 minutes in the app today". Denied, the nudge still works.
         Both are special permissions granted from a settings page, not a dialog. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Lets the target-app picker see launchable apps on API 30+.
         Deliberately NOT QUERY_ALL_PACKAGES: that is Play-policy-sensitive and
         needs a declaration form, and this app already carries one rejection. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
</manifest>
